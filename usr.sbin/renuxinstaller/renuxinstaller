#
# renuxinstaller - install Renux to a disk by cloning the running live system.
#
# Detects the available disks, lets you pick one (like the FreeBSD
# bsdinstall), partitions it (GPT + EFI System Partition + UFS root), formats
# it, copies the live world to it, installs the boot loader and writes a
# proper /etc/fstab and /boot/loader.conf.  No distribution sets are needed.
#
# Usage: renuxinstaller [/dev/disk]

BSDCFG_SHARE="/usr/share/bsdconfig"
[ -f "$BSDCFG_SHARE/common.subr" ] && . "$BSDCFG_SHARE/common.subr"

: ${BSDINSTALL_CHROOT:="/mnt"}
: ${TMPDIR:="/tmp"}
: ${ESP_SIZE:="128m"}

LIVE_ROOT="$(mount | awk '$3 == "/" { print $1; exit }')"

############################################################ UI helpers

f_msg()
{
	if command -v bsddialog >/dev/null 2>&1; then
		bsddialog --backtitle "Renux Installer" --title "$1" --msgbox "$2" 0 0
	else
		echo "*** $1"
		echo "$2"
	fi
}

f_confirm()
{
	local ans
	if command -v bsddialog >/dev/null 2>&1; then
		bsddialog --backtitle "Renux Installer" --title "$1" \
		    --yesno "$2" 0 0
	else
		echo "*** $1"
		echo "$2"
		printf 'Type YES to continue: '
		read ans
		[ "$ans" = "YES" ]
	fi
}

############################################################ Disk detection

# Returns the raw disk device names (ada0, vtbd0, nvme0ns1, ...), excluding
# the media we are booting from.  Uses kern.disks when available and also
# scans /dev as a fallback.
f_list_disks()
{
	local n seen
	seen=""
	if sysctl -n kern.disks >/dev/null 2>&1; then
		for n in $(sysctl -n kern.disks 2>/dev/null); do
			case " $seen " in *" $n "*) continue ;; esac
			case "$n" in cd*|md*) continue ;; esac
			[ -e "/dev/$n" ] || continue
			case "$LIVE_ROOT" in
			/dev/iso9660/*|/dev/cd*) ;;
			*"$n"*) continue ;;
			esac
			seen="$seen $n"
		done
	fi
	for n in /dev/ada[0-9]* /dev/da[0-9]* /dev/vtbd[0-9]* \
	    /dev/nvd[0-9]* /dev/nvme[0-9]*ns[0-9]*; do
		n="${n#/dev/}"
		[ -e "/dev/$n" ] || continue
		case " $seen " in *" $n "*) continue ;; esac
		seen="$seen $n"
	done
	echo "$seen" | tr ' ' '\n' | sed '/^$/d'
}

f_disk_size()
{
	diskinfo -v "/dev/$1" 2>/dev/null |
	    awk '$3 == "mediasize" { printf "%.1f GB", $1 / 1073741824 }'
}

############################################################ Target disk

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
	DISKS="$(f_list_disks)"
	if [ -z "$DISKS" ]; then
		f_msg "No disks" \
		    "No disks found to install Renux to.\n\nRun 'sysctl kern.disks' or 'geom disk list' to list devices."
		exit 1
	fi

	if command -v bsddialog >/dev/null 2>&1; then
		# Build the menu list: "/dev/ada0" "16.0 GB" ...
		menu_args=""
		for n in $DISKS; do
			menu_args="$menu_args /dev/$n \"$(f_disk_size "$n")\""
		done
		TARGET="$(eval bsddialog --backtitle 'Renux Installer' \
		    --title 'Target Disk' \
		    --menu 'Select the disk to install Renux to. ALL DATA ON IT WILL BE ERASED:' \
		    0 0 0 $menu_args 2>&1 >/dev/tty)"
	fi
	if [ -z "$TARGET" ]; then
		echo "Available disks:"
		i=1
		for n in $DISKS; do
			echo "    $i) /dev/$n  ($(f_disk_size "$n"))"
			i=$((i + 1))
		done
		printf 'Select a disk number [1-%s]: ' "$((i - 1))"
		read sel
		n="$(echo "$DISKS" | awk -v s="$sel" 'NR == s { print }')"
		[ -n "$n" ] && TARGET="/dev/$n"
	fi
fi

[ -n "$TARGET" ] && [ -e "$TARGET" ] || {
	echo "error: disk '$TARGET' does not exist."
	echo "Detected disks on this system:"
	for n in $(f_list_disks); do
		echo "    /dev/$n  ($(f_disk_size "$n"))"
	done
	echo "Tip: run 'sysctl kern.disks' or 'geom disk list' to list devices."
	f_msg "Invalid disk" \
	    "Disk '$TARGET' does not exist.\n\nDetected disks:\n$(for n in $(f_list_disks); do echo "  /dev/$n"; done)"
	exit 1
}

f_confirm "Warning" \
	"This will DESTROY ALL DATA on $TARGET and install Renux on it.\n\n$TARGET" || {
	echo "Install aborted."
	exit 1
}

############################################################ Partition
# GPT with freebsd-boot (BIOS stage), ESP (UEFI) and UFS root, so the
# installed system boots on both BIOS and UEFI.

echo "Partitioning $TARGET (GPT: freebsd-boot + ESP + UFS root)..."
gpart destroy -F "$TARGET" 2>/dev/null
gpart create -s gpt "$TARGET" || { echo "error: gpart create failed"; exit 1; }
gpart add -t freebsd-boot -b 40 -s 128k -l boot0 "$TARGET" ||
    { echo "error: could not add BIOS boot partition"; exit 1; }
gpart add -t efi -a 4k -s "$ESP_SIZE" -l efiboot "$TARGET" ||
    { echo "error: could not add ESP partition"; exit 1; }
gpart add -t freebsd-ufs -a 4k -l rootfs "$TARGET" ||
    { echo "error: could not add root partition"; exit 1; }

# BIOS boot code: PMBR + gptboot in the freebsd-boot partition.
if [ -f /boot/pmbr ] && [ -f /boot/gptboot ]; then
	echo "Installing BIOS boot code (pmbr + gptboot)..."
	gpart bootcode -b /boot/pmbr -p /boot/gptboot -i 1 "$TARGET" ||
	    echo "warning: could not write BIOS boot code"
else
	echo "warning: /boot/pmbr or /boot/gptboot missing; BIOS boot may not work"
fi

ESP="/dev/gpt/efiboot"
ROOT="/dev/gpt/rootfs"

############################################################ Filesystems

echo "Creating filesystems..."
newfs_msdos -L RENUX "$ESP" >/dev/null || { echo "error: newfs_msdos failed"; exit 1; }
newfs -U -O 2 -L rootfs "$ROOT" >/dev/null || { echo "error: newfs failed"; exit 1; }

############################################################ Mount

echo "Mounting ${BSDINSTALL_CHROOT}..."
mount "$ROOT" "${BSDINSTALL_CHROOT}" || { echo "error: mount root failed"; exit 1; }
# The mountpoint must exist inside the target root (after mounting), otherwise
# the freshly-formatted empty UFS hides it.
mkdir -p "${BSDINSTALL_CHROOT}/boot/efi"
mount -t msdosfs "$ESP" "${BSDINSTALL_CHROOT}/boot/efi" ||
    { echo "error: mount ESP failed"; exit 1; }

############################################################ Clone the live world

echo "Cloning the live system to ${BSDINSTALL_CHROOT} (this may take a while)..."
(
	cd / || exit 1
	tar -cf - --exclude=./${BSDINSTALL_CHROOT#/} --exclude=./dev \
	    --exclude=./proc --exclude=./sys --exclude=./tmp --exclude=./mnt \
	    --exclude=./boot/efi --exclude=./var/run --exclude=./var/log \
	    --exclude=./var/tmp --exclude=./var/db .
) | dd bs=1m status=progress |
    ( cd "${BSDINSTALL_CHROOT}" && tar -xf - ) ||
    { echo "error: failed to clone the live system"; umount -a; exit 1; }

# Make sure the runtime and special directories exist on the target (the
# clone excludes /dev, /proc, /sys and the tmpfs runtime dirs).
mkdir -p "${BSDINSTALL_CHROOT}/dev" "${BSDINSTALL_CHROOT}/proc" \
    "${BSDINSTALL_CHROOT}/sys" "${BSDINSTALL_CHROOT}/tmp" \
    "${BSDINSTALL_CHROOT}/var/run" "${BSDINSTALL_CHROOT}/var/log" \
    "${BSDINSTALL_CHROOT}/var/tmp" "${BSDINSTALL_CHROOT}/var/db" 2>/dev/null
# mkdir -p honours the umask, so the fresh dirs are 0755 root.  /tmp and
# /var/tmp must be 1777 (sticky, world-writable): Xorg's xkbcomp writes
# /tmp/server-0.xhm there and fails with "cannot open /tmp/server-0.xhm"
# (then "failed to activate virtual core keyboard: 2") for regular users.
chmod 1777 "${BSDINSTALL_CHROOT}/tmp" "${BSDINSTALL_CHROOT}/var/tmp"
chmod 0775 "${BSDINSTALL_CHROOT}/var/run" "${BSDINSTALL_CHROOT}/var/log"

# bsdtar matches an exclude pattern like './sys' against the basename of any
# path component, not just the top-level mount point.  The clone above
# therefore silently drops nested directories such as /usr/include/sys (gcc
# then fails with "sys/cdefs.h: No such file").  The '-./var/run' style
# patterns are safe (they contain a slash and only match the full path), but
# the short names (dev, proc, sys, tmp, mnt) are not.  Restore any nested
# directories the live system actually ships.
for base in sys dev proc tmp mnt; do
    find /usr /boot -type d -name "$base" 2>/dev/null |
    while IFS= read -r d; do
        rel="${d#/}"
        [ -e "${BSDINSTALL_CHROOT}/${rel}" ] && continue
        mkdir -p "${BSDINSTALL_CHROOT}/${rel%/*}" 2>/dev/null
        cp -a "$d" "${BSDINSTALL_CHROOT}/${rel%/*}/" 2>/dev/null &&
            echo "restored ${rel}"
    done
done

############################################################ Boot loader

# UEFI: the EFI loader lives at /EFI/BOOT/BOOTX64.EFI in the world (the
# /boot/loader on the live media is the BIOS loader).  Copy it to the ESP.
echo "Installing the boot loader (BIOS + UEFI)..."
mkdir -p "${BSDINSTALL_CHROOT}/boot/efi/EFI/BOOT"
if [ -f "${BSDINSTALL_CHROOT}/EFI/BOOT/BOOTX64.EFI" ]; then
	cp "${BSDINSTALL_CHROOT}/EFI/BOOT/BOOTX64.EFI" \
	    "${BSDINSTALL_CHROOT}/boot/efi/EFI/BOOT/BOOTX64.EFI" ||
	    echo "warning: could not copy the EFI loader"
elif [ -f /boot/loader.efi ]; then
	cp /boot/loader.efi "${BSDINSTALL_CHROOT}/boot/efi/EFI/BOOT/BOOTX64.EFI" ||
	    echo "warning: could not copy the EFI loader"
else
	echo "warning: EFI loader not found; UEFI boot may not work"
fi

# The loader auto-detects its console, so the same loader.conf works for
# both BIOS and UEFI boots.  Set the root explicitly: the cloned
# /boot/defaults/loader.conf points at the live CD
# (vfs.root.mountfrom=cd9660:/dev/iso9660/RENUX), which must not survive.
cat > "${BSDINSTALL_CHROOT}/boot/loader.conf" <<EOF
autoboot_delay="2"
loader_logo="renux"
vfs.root.mountfrom="ufs:$ROOT"
EOF
cp "${BSDINSTALL_CHROOT}/boot/loader.conf" \
    "${BSDINSTALL_CHROOT}/boot/defaults/loader.conf"

############################################################ /etc/fstab

cat > "${BSDINSTALL_CHROOT}/etc/fstab" <<EOF
$ROOT		/		ufs	rw	1 1
$ESP		/boot/efi	msdosfs	rw	2 2
EOF

############################################################ Root password

if f_confirm "Root password" \
    "Set a password for root now? (NO keeps the empty live password)"; then
	chroot "${BSDINSTALL_CHROOT}" passwd root 2>/dev/null ||
	    echo "warning: could not set the root password"
fi

if f_confirm "Create a user" \
    "Create a regular user account (in the wheel group) for daily use?"; then
	printf 'Username: '
	read uname
	if [ -n "$uname" ]; then
		if chroot "${BSDINSTALL_CHROOT}" pw useradd "$uname" \
		    -m -g wheel -h 0 2>/dev/null; then
			echo "User $uname created (with password)."
		else
			echo "warning: could not create user $uname"
		fi
	fi
fi

############################################################ Finish

sync
umount "${BSDINSTALL_CHROOT}/boot/efi" 2>/dev/null
umount "${BSDINSTALL_CHROOT}" 2>/dev/null

f_msg "Installation complete" \
	"Renux has been installed to $TARGET.\n\nYou can now reboot into your new system."

exit 0
