-- Point the Lua module loader at tools/renux/ so require("renux.foo") works.
local script_dir = arg[0]:match("^(.+)/[^/]+$") or "."
package.path = script_dir .. "/tools/?.lua;" .. package.path

require("renux.main")(arg)
