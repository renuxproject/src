#
# renux - the Renux build utility (launcher).
#
# The logic lives in Lua (renux.lua), run by FreeBSD's flua.  This tiny
# launcher only finds a Lua interpreter: first flua in $PATH, then a system
# Lua, then the bootstrap flua built by this tree.  That way it works on any
# host and even before the bootstrap tools exist.

DIR="$(cd "$(dirname "$0")" && pwd)"
LUA=

for c in flua lua5.4 lua luajit; do
	if command -v "$c" >/dev/null 2>&1; then
		LUA="$c"
		break
	fi
done

# flua lives in /usr/libexec on a FreeBSD base system (not always in PATH).
if [ -z "$LUA" ] && [ -x /usr/libexec/flua ]; then
	LUA=/usr/libexec/flua
fi

if [ -z "$LUA" ]; then
	# Bootstrap flua built by this tree (cross-build host or native build).
	LUA="$(find "$DIR/obj" -type f -name flua \
	    -path '*/legacy/*' 2>/dev/null | head -n1)"
	[ -z "$LUA" ] && LUA="$(find "$DIR/obj" -type f -name flua 2>/dev/null | head -n1)"
fi

if [ -z "$LUA" ]; then
	cat >&2 <<EOF
renux: no Lua interpreter found (flua, lua5.4, lua or luajit).

Install one (e.g. apt install lua5.4) or build the bootstrap tools.
EOF
	exit 1
fi

exec "$LUA" "$DIR/renux.lua" "$@"
